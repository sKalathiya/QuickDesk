#PostgreSQL
POSTGRES_USER=Username of the user
POSTGRES_PASSWORD=Password of the user
POSTGRES_DB=Name of the database
POSTGRES_PORT=Port of the database
POSTGRES_HOST=Host of the database

#Google API Key
GOOGLE_API_KEY=Google API Key

JWT_SECRET_KEY=# This is a random string
